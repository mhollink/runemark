{
  "name": "runemark",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @runemark/web dev",
    "build": "pnpm --filter @runemark/web build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "check": "biome ci .",
    "format": "biome check --write .",
    "verify": "pnpm format && pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "world:graph": "tsx tooling/generate-world-graph.ts"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
